#include <bits/stdc++.h>
using namespace std;

int main() {
    string s;
    cin >> s;

    vector<char> ans;
    string ai;

    for (int i = 0; i < s.length(); i++) {
        if (s[i] != '+') {
            ans.push_back(s[i]);
        }
    }

    sort(ans.begin(), ans.end());

    for (int i = 0; i < ans.size(); i++) {
        ai += ans[i];
        ai += '+';
    }

    ai.pop_back();

    cout << ai;
}
