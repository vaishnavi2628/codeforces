#include <iostream>
#include <vector>
using namespace std;


bool isPrime(int x) {
    if (x < 2)
        return false;

    for (int i = 2; i * i <= x; i++) {
        if (x % i == 0)
            return false;
    }

    return true;
}

int main() {
    int n, k;
    cin >> n >> k;

    vector<int> primes;
    vector<bool> prime(n + 1, false);


    for (int i = 2; i <= n; i++) {
        if (isPrime(i)) {
            primes.push_back(i);
            prime[i] = true;
        }
    }

    int count = 0;

    
    for (int i = 0; i < primes.size() - 1; i++) {
        int sum = primes[i] + primes[i + 1] + 1;

        if (sum <= n && prime[sum])
            count++;
    }

    if (count >= k)
        cout << "YES";
    else
        cout << "NO";

    return 0;
}
