#include<bits/stdc++.h>
using namespace std;

int main(){

    int t;
    cin >> t;

    while(t--){
        int n;
        cin >> n;

        string s;
        cin >> s;

        int i = 0;
        int count = 0;
        int three = 0;
        bool flag = false;

        while(i < s.length()){

            if(s[i] == '.'){
                count++;
                int j = i;
                three = 0;

                while(j < i + 3 && j < s.length()){
                    if(s[j] == '.'){
                        three++;
                    }

                    j++;

                    if(three == 3){
                        flag = true;
                        break;
                    }
                }
            }

            if(flag){
                break;
            }

            i++;
        }

        if(flag){
            cout << 2 << endl;
        }
        else{
            cout << count << endl;
        }
    }

    return 0;
}
