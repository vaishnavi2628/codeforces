#include<bits/stdc++.h>
using namespace std;

int main() {

    int t;
    cin >> t;

    while (t--) {

        int n;
        cin >> n;

        if (n % 2 != 0) {
            cout << "NO"<<endl;
            for (int i = 1; i <= n; i++) {
                int x;
                cin >> x;
            }
            continue;
        }

        int mini = INT_MAX;
        int maxi = INT_MIN;

        for (int i = 1; i <= n; i++) {
            int value;
            cin >> value;

            if (i % 2 == 0)
                maxi = max(maxi, value);   
            else
                mini = min(mini, value);  
        }

        if (mini - maxi >= 2)
            cout << "YES"<<endl;
        else
            cout << "NO"<<endl;
    }

    return 0;
}
